<CodeDescription>
<Title>A10</Title>
<Definition>PA (Pascal)
One pascal is equivalent to 1 newton (N) of force applied over an area of 1 square meter (m2).</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="A11">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>A11</Title>
<Definition>K (Kelvin)
Kelvin is the Standard International ( SI ) unit of thermodynamic temperature.
One kelvin is formally defined as: 
1/273.16 (3.6609 x 10 -3 ) of the thermodynamic temperature of the triple point of pure water (H 2 O).</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="A12">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>A12</Title>
<Definition>Mass percentage (Mass-%).
The percentage of mass of an object.</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="A13">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>A13</Title>
<Definition>Tonnes.
A metric unit of mass, defined as 1000 kilograms.</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="A14">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>A14</Title>
<Definition>Kg.
A metric unit of mass, defined as 1000 grams.</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="A15">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>A15</Title>
<Definition>Kg/h
Kg per hour.</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
<xsd:enumeration value="KW4">
<xsd:annotation>
<xsd:documentation>
<CodeDescription>
<Title>KW4</Title>
<Definition>Kilowatt hour per kilo gram (kWh/kg).
1000 watts per hour per kilo gram of mass. 
.</Definition>
</CodeDescription>
</xsd:documentation>
</xsd:annotation>
</xsd:enumeration>
</xsd:restriction>
</xsd:simpleType>
